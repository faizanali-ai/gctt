# Copy to .env for local development or paste into Render's environment.
# Free-tier stack: Render (web) + Neon (Postgres) + Resend (email) + R2 (media).

# --- Django ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=your-app.up.railway.app,yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app,https://yourdomain.com

# --- Database (Neon free plan) ---
# Required when DJANGO_DEBUG is off. Use the POOLED connection string
# (its host contains "-pooler") for short-lived web workers.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require

# --- Cache (optional; without it production uses a database cache table) ---
# REDIS_URL=redis://default:pass@host:6379

# --- Email (Resend / any SMTP) ---EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_xxxxxxxx
DEFAULT_FROM_EMAIL=Accounts@gctekton.com

# --- Media storage (Cloudflare R2, private bucket with signed URLs) ---
R2_BUCKET=gctt-media
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Monitoring (optional) ---
SENTRY_DSN=

# --- Staff security (set 1 once every staff account has enrolled in 2FA) ---
REQUIRE_STAFF_2FA=0
