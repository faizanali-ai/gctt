# Copy to .env for local development. For Render, set these in the dashboard
# or render.yaml; never commit a real .env or a real API key.

# --- Django ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string-at-least-50-characters
DJANGO_ALLOWED_HOSTS=gctekton.com,www.gctekton.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://gctekton.com,https://www.gctekton.com
SITE_URL=https://gctekton.com

# --- Database (Neon free plan) ---
# Required when DJANGO_DEBUG is off. Use the pooled connection string.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require

# --- Cache (optional; production otherwise uses the database cache table) ---
# REDIS_URL=redis://default:pass@host:6379

# --- Email (Resend HTTPS API; required in production on Render Free) ---
EMAIL_BACKEND=config.email_backends.ResendEmailBackend
RESEND_API_KEY=re_xxxxxxxx
DEFAULT_FROM_EMAIL=accounts@gctekton.com
# Optional: EMAIL_TIMEOUT=10
# Optional: EMAIL_SEND_RETRIES=1
# Optional: EMAIL_RETRY_DELAY_SECONDS=0.5

# SMTP fallback is for local development or a paid host that allows outbound
# SMTP. Do not use it on Render Free: ports 25/465/587 are blocked.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# --- Email OTP login ---
REQUIRE_EMAIL_OTP=1
EMAIL_OTP_TTL_SECONDS=600
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_SECONDS=60
# Set to 1 after auditing existing unverified candidates/students.
REQUIRE_VERIFIED_EMAIL_ACTIONS=0

# --- Media storage: production needs one remote backend ---

# Supabase Storage (currently configured in production)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_REGION=us-east-1
SUPABASE_BUCKET=media
SUPABASE_ACCESS_KEY_ID=
SUPABASE_SECRET_ACCESS_KEY=

# Optional alternative: Cloudflare R2
# R2_BUCKET=gctt-media
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# --- Monitoring ---
SENTRY_DSN=

# --- Google OAuth 2.0 (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- LinkedIn company posting (optional) ---
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
