# Copy to .env and fill in for deployment. Leave unset in local development.

# --- Django ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=your-app.up.railway.app,yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app,https://yourdomain.com

# --- Database (Neon) ---
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# --- Email (Resend / any SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_xxxxxxxx
DEFAULT_FROM_EMAIL=Accounts@gctekton.com

# --- Media storage (Cloudflare R2) ---
R2_BUCKET=gctt-media
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=https://media.gctekton.com/
