# Copy to .env for local development or paste into Render's environment.
# Free-tier stack: Render (web) + Neon (Postgres) + Resend (email) + R2 (media).

# --- Django ---
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=your-app.up.railway.app,yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app,https://yourdomain.com

# --- Database (Neon free plan) ---
# Required when DJANGO_DEBUG is off. Use the POOLED connection string
# (its host contains "-pooler") for short-lived web workers.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require

# --- Cache (optional; without it production uses a database cache table) ---
# REDIS_URL=redis://default:pass@host:6379

# --- Email (Resend / any SMTP) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_xxxxxxxx
DEFAULT_FROM_EMAIL=accounts@gctekton.com

# --- Email OTP login (defaults shown; optional overrides) ---
EMAIL_OTP_TTL_SECONDS=600
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_SECONDS=60

# --- Media storage: choose ONE of the two ---

# Option A: Cloudflare R2 (private bucket, signed URLs)
# R2_BUCKET=gctt-media
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Option B: Supabase Storage (free, no card). Create a private bucket "media"
# and S3 credentials under Project Settings → Storage → S3 connection.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_REGION=us-east-1
SUPABASE_BUCKET=media
SUPABASE_ACCESS_KEY_ID=
SUPABASE_SECRET_ACCESS_KEY=

# --- Monitoring (optional) ---
SENTRY_DSN=

# --- Internal email OTP (set 1 once Resend/domain delivery is verified) ---
# 0 keeps password-only fallback active; candidates/students always use password.
REQUIRE_EMAIL_OTP=0

# --- Google OAuth 2.0 (Sign in with Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
